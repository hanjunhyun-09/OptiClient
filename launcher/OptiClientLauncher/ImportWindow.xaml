<Window x:Class="OptiClientLauncher.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptiClientLauncher"
        Title="다른 런처에서 가져오기" Icon="/Assets/opticlient.ico" Width="1040" Height="740" MinWidth="820" MinHeight="520"
        Background="#0E0F14" FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- 선택 칩 -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="13" Background="#1F2128" Padding="13,5" BorderBrush="#2E323C" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentGradient}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="다른 런처에서 가져오기" FontSize="20" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Lunar · Feather · Badlion · Silent 클라이언트 프로필(HUD 배치·모드 설정)과 공식 런처 · Prism · Modrinth App · CurseForge 의 설정·모드팩을 OptiClient 로 가져와요. 계정·로그인 정보는 읽지 않아요."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 찾은 런처·인스턴스 -->
            <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="6" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,6,6,8">
                        <Button DockPanel.Dock="Right" Content="📦  모드팩 파일 열기 (.mrpack)" Click="OpenPack_Click" Margin="0"/>
                        <TextBlock x:Name="ScanText" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="다른 런처를 찾는 중..."/>
                    </DockPanel>
                    <ListBox x:Name="Sources" SelectionChanged="Sources_SelectionChanged" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ImportSource}">
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#2A1A1D" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Launcher}" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="·" Style="{StaticResource Muted}" Margin="6,0"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="9" Background="#1F2128" Padding="9,3" Margin="10,0,4,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="#B9BDC9"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 오른쪽: 가져올 곳 / 항목 -->
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="16" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="가져올 곳" Style="{StaticResource Section}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="NewTarget" Style="{StaticResource Chip}" Content="새 프로필 만들기" GroupName="target" IsChecked="True" Checked="Target_Changed"/>
                            <RadioButton x:Name="CurrentTarget" Style="{StaticResource Chip}" Content="선택한 프로필에 넣기" GroupName="target" Checked="Target_Changed"/>
                        </WrapPanel>
                        <StackPanel x:Name="NewPanel" Margin="0,6,0,0">
                            <TextBlock Text="프로필 이름" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox x:Name="NameBox"/>
                            <TextBlock Text="버전" Style="{StaticResource Muted}" Margin="0,12,0,8"/>
                            <WrapPanel x:Name="VersionChips"/>
                        </StackPanel>
                        <TextBlock x:Name="CurrentText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <TextBlock Text="가져올 항목" Style="{StaticResource Section}" Margin="0,18,0,12"/>
                        <CheckBox x:Name="HudCheck" Content="클라이언트 HUD · 모드 설정 (켜짐 · 위치 · 크기)" IsChecked="True" Visibility="Collapsed"/>
                        <CheckBox x:Name="SettingsCheck" Content="게임 설정 (키 · 감도 · 시야각 · 소리 · 언어)" IsChecked="True"/>
                        <CheckBox x:Name="GraphicsCheck" Content="그래픽 설정도 (끄면 최적화 값 유지)"/>
                        <CheckBox x:Name="ServersCheck" Content="서버 목록" IsChecked="True"/>
                        <CheckBox x:Name="PacksCheck" Content="리소스팩" IsChecked="True"/>
                        <CheckBox x:Name="ShadersCheck" Content="셰이더팩" IsChecked="True"/>
                        <CheckBox x:Name="ModsCheck" Content="모드" IsChecked="True"/>
                        <CheckBox x:Name="ConfigsCheck" Content="모드 설정 (config 폴더)" IsChecked="True"/>
                        <CheckBox x:Name="WorldsCheck" Content="월드 (용량이 클 수 있어요)"/>

                        <Border CornerRadius="10" Background="#1F2128" Padding="12,10" Margin="0,8,0,0">
                            <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="#B9BDC9" LineHeight="19"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="취소" IsCancel="True"/>
                <Button x:Name="ImportButton" Content="가져오기" Style="{StaticResource Primary}" Margin="0" Click="Import_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
