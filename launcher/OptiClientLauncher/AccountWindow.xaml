<Window x:Class="OptiClientLauncher.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="계정" Icon="/Assets/opticlient.ico" Width="560" Height="600" ResizeMode="NoResize"
        Background="#0E0F14" FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 현재 계정 -->
        <Border CornerRadius="14" Padding="14" Background="#CC1C1E25" BorderBrush="#33E5383B" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                    <TextBlock x:Name="AvatarText" Text="?" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentName" Text="로그인한 계정 없음" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentType" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,16,0,0" x:Name="Tabs">
            <TabItem Header="정품 (추천)">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="21">
                        공식 마인크래프트 런처에 로그인된 정품 계정으로 실행해요.<LineBreak/>
                        OptiClient 에서 [플레이] 를 누르면 공식 런처가 열리고, 공식 런처의 플레이 버튼까지 자동으로 눌러 줘요.
                    </TextBlock>
                    <Button Content="정품 계정으로 사용" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="UseOfficial_Click"/>
                    <Border CornerRadius="10" Background="#14FFFFFF" Padding="12,10" Margin="0,18,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#B9BDC9" LineHeight="19">
                            • 하이픽셀 같은 정품 서버, Realms 모두 들어갈 수 있어요.<LineBreak/>
                            • 처음 한 번은 공식 런처에서 Microsoft 계정으로 로그인해 두세요.<LineBreak/>
                            • OptiClient 는 계정 정보·비밀번호를 전혀 읽거나 저장하지 않아요.<LineBreak/>
                            • 공식 런처가 자바 에디션 화면이 아닌 곳에서 열리면 자동 클릭이 안 될 수 있어요. 그때는 플레이를 직접 눌러 주세요.
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="오프라인">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="닉네임 (영문·숫자·_ 3~16자)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="OfflineName" FontSize="14"/>
                    <Button Content="이 닉네임으로 사용" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="UseOffline_Click"/>
                    <Border CornerRadius="10" Background="#1AFFC857" Padding="12,10" Margin="0,18,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="#FFC857" FontSize="12.5"
                                   Text="오프라인 모드는 싱글플레이·LAN·오프라인(비정품 허용) 서버에서만 쓸 수 있어요. 하이픽셀 같은 정품 서버에 들어가려면 Microsoft 로그인이 필요해요."/>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Microsoft (앱 ID)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="앱 클라이언트 ID" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ClientIdBox" FontFamily="Consolas, Malgun Gothic"/>

                        <Border CornerRadius="10" Background="#14FFFFFF" Padding="12,10" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#B9BDC9" LineHeight="19">
                                새 런처가 Microsoft 로그인을 쓰려면 직접 앱을 등록하고 승인을 받아야 해요 (한 번만).<LineBreak/>
                                1. <Hyperlink NavigateUri="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" RequestNavigate="Link_Click" Foreground="#FF7A45">Azure 앱 등록</Hyperlink> 에서 새 앱 등록 → 지원 계정 유형: <Bold>개인 Microsoft 계정</Bold><LineBreak/>
                                2. 인증 → <Bold>공용 클라이언트 흐름 허용</Bold> 을 "예" 로<LineBreak/>
                                3. <Hyperlink NavigateUri="https://aka.ms/mce-reviewappid" RequestNavigate="Link_Click" Foreground="#FF7A45">Minecraft API 승인 신청</Hyperlink> (승인까지 며칠 걸릴 수 있어요)<LineBreak/>
                                4. 승인되면 앱의 "애플리케이션(클라이언트) ID" 를 위 칸에 넣고 로그인
                            </TextBlock>
                        </Border>

                        <Button x:Name="MsLoginButton" Content="Microsoft 로 로그인" Style="{StaticResource Primary}" HorizontalAlignment="Left"
                                Margin="0,14,0,0" Click="MsLogin_Click"/>

                        <!-- 기기 코드 -->
                        <Border x:Name="CodePanel" Visibility="Collapsed" CornerRadius="14" Margin="0,14,0,0" Padding="16"
                                Background="#2BE5383B" BorderBrush="#66E5383B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="브라우저에서 아래 코드를 입력하세요" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="UserCode" FontSize="30" FontWeight="Bold" FontFamily="Consolas" Margin="0,6,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="코드 복사 + 브라우저 열기" Click="OpenBrowser_Click"/>
                                    <Button Content="취소" Click="CancelLogin_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="MsStatus" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" IsCancel="True" Margin="0"/>
            <Button Content="로그아웃" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="Logout_Click"/>
        </DockPanel>
    </Grid>
</Window>
