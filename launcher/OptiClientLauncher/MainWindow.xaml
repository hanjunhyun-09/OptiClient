<Window x:Class="OptiClientLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OptiClientLauncher"
        Title="OptiClient Launcher" Icon="/Assets/opticlient.ico" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" Background="#0B0C11"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 버전 선택 알약 버튼 -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="14" Background="#1F2128" BorderBrush="#2E323C" BorderThickness="1"/>
                            <Border x:Name="on" CornerRadius="14" Opacity="0"
                                    Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VersionBrush}, ConverterParameter=soft}"
                                    BorderBrush="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VersionBrush}}" BorderThickness="1.5"/>
                            <StackPanel Orientation="Horizontal" Margin="14,7">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VersionBrush}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#272A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 제목 표시줄 버튼 -->
        <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0C11" Offset="0"/>
                <GradientStop Color="#10111A" Offset="0.5"/>
                <GradientStop Color="#1C0A0F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ===== 움직이는 배경: 흐릿한 빛 덩어리 + 떠오르는 입자 ===== -->
        <Canvas x:Name="FxCanvas" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse x:Name="Blob1" Width="520" Height="520" Canvas.Left="-80" Canvas.Top="380" Opacity="0.30">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#E5383B" Offset="0"/><GradientStop Color="#00E5383B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Blob2" Width="460" Height="460" Canvas.Left="720" Canvas.Top="-120" Opacity="0.22">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF7A45" Offset="0"/><GradientStop Color="#00FF7A45" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="Blob3" Width="420" Height="420" Canvas.Left="420" Canvas.Top="420" Opacity="0.16">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#A78BFA" Offset="0"/><GradientStop Color="#00A78BFA" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <Canvas x:Name="Particles" ClipToBounds="True" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== 제목 표시줄 ===== -->
            <DockPanel Margin="18,0,4,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="최소화"/>
                    <Button Style="{StaticResource Caption}" Content="&#xE922;" Click="Maximize_Click" ToolTip="최대화"/>
                    <Button Style="{StaticResource Caption}" Content="&#xE8BB;" Click="Close_Click" ToolTip="닫기"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock Text="OPTI" FontWeight="Black" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="CLIENT" FontWeight="Black" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  마인크래프트 최적화 클라이언트" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 왼쪽: 프로필 ===== -->
                <Border x:Name="Sidebar" Background="{StaticResource Panel}" CornerRadius="18" Padding="14" Margin="0,0,14,0"
                        BorderBrush="#1FFFFFFF" BorderThickness="1" Opacity="0">
                    <Border.RenderTransform><TranslateTransform X="-30"/></Border.RenderTransform>
                    <DockPanel>
                        <!-- 계정 칩 -->
                        <Border DockPanel.Dock="Top" CornerRadius="12" Padding="10,8" Margin="0,0,0,14" Cursor="Hand"
                                Background="#22FFFFFF" BorderBrush="#33E5383B" BorderThickness="1" MouseLeftButtonUp="Account_Click"
                                ToolTip="계정 바꾸기">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradient}" Margin="0,0,10,0">
                                    <TextBlock x:Name="AccountAvatar" Text="?" FontWeight="Bold" FontSize="15" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Text="로그인하기" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountType" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="4,2,4,10">
                            <TextBlock x:Name="ProfileCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="프로필" Style="{StaticResource Section}"/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="＋  새 프로필" Style="{StaticResource Primary}" FontSize="13" Padding="0,9" Margin="0,0,0,8" Click="NewProfile_Click"/>
                            <Button Content="⇩  다른 런처에서 가져오기" Margin="0,0,0,8" Click="ImportFrom_Click"
                                    ToolTip="공식 런처 · Lunar · Badlion · Feather · Prism · Modrinth App · CurseForge 의 설정과 모드팩 가져오기"/>
                            <UniformGrid Columns="2">
                                <Button Content="복제" Click="CloneProfile_Click"/>
                                <Button Content="삭제" Style="{StaticResource DangerButton}" Margin="0" Click="DeleteProfile_Click"/>
                            </UniformGrid>
                        </StackPanel>
                        <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Profile}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,12,0"
                                                Background="{Binding GameVersion, Converter={StaticResource VersionBrush}, ConverterParameter=soft}"
                                                BorderBrush="{Binding GameVersion, Converter={StaticResource VersionBrush}}" BorderThickness="1.5">
                                            <TextBlock Text="{Binding GameVersion}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding GameVersion, Converter={StaticResource VersionBrush}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- ===== 오른쪽: 선택한 프로필 ===== -->
                <Grid Grid.Column="1" x:Name="Editor" DataContext="{Binding SelectedItem, ElementName=ProfileList}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 히어로 -->
                    <Border x:Name="Hero" CornerRadius="20" Padding="28,24" BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True" Opacity="0">
                        <Border.RenderTransform><TranslateTransform Y="16"/></Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="HeroTint" Color="#55E5383B" Offset="0"/>
                                <GradientStop Color="#CC15161C" Offset="0.55"/>
                                <GradientStop Color="#E615161C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 큰 장식 글자 -->
                            <TextBlock Grid.ColumnSpan="2" Text="{Binding GameVersion}" FontSize="120" FontWeight="Black" Opacity="0.06"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-40,220,-40" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Margin="0,0,0,10"
                                        Background="{Binding GameVersion, Converter={StaticResource VersionBrush}, ConverterParameter=soft}"
                                        BorderBrush="{Binding GameVersion, Converter={StaticResource VersionBrush}}" BorderThickness="1">
                                    <TextBlock Text="{Binding Subtitle}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{Binding GameVersion, Converter={StaticResource VersionBrush}}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Border CornerRadius="9" Background="#22FFFFFF" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock x:Name="ModCountText" FontSize="12"/>
                                    </Border>
                                    <Border CornerRadius="9" Background="#22FFFFFF" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock FontSize="12" Text="{Binding MemoryMb, StringFormat=메모리 {0} MB}"/>
                                    </Border>
                                    <Border CornerRadius="9" Background="#22FFFFFF" Padding="10,4">
                                        <TextBlock FontSize="12" Text="공식 런처 없이 바로 실행"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Grid>
                                    <!-- 맥박처럼 퍼지는 빛 -->
                                    <Border x:Name="PlayGlow" CornerRadius="16" Background="{StaticResource AccentGradient}" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                                        <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
                                        <Border.RenderTransform><ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Button x:Name="PlayButton" Width="210" Height="58" Margin="0" Style="{StaticResource Primary}" Click="Play_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="16" Margin="0,0,10,0" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PlayLabel" Text="플레이" FontSize="19" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button x:Name="InstallButton" Content="설치만 하기" Style="{StaticResource Ghost}" Click="Install_Click"
                                            Foreground="{StaticResource MutedBrush}"/>
                                    <Button Content="정품으로 플레이 (공식 런처)" Style="{StaticResource Ghost}" Click="OfficialLauncher_Click"
                                            Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 탭 -->
                    <Border x:Name="TabsPanel" Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource Panel}" CornerRadius="18" Padding="20,14,20,16"
                            BorderBrush="#1FFFFFFF" BorderThickness="1" Opacity="0">
                        <Border.RenderTransform><TranslateTransform Y="20"/></Border.RenderTransform>
                        <TabControl x:Name="Tabs">
                            <TabItem Header="모드">
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Button Content="🔍  Modrinth 검색" Click="SearchMods_Click" Margin="0,0,6,6"/>
                                        <Button Content="📁  파일 추가" Click="AddLocalMod_Click" Margin="0,0,6,6"/>
                                        <Button Content="⚡  최적화 프리셋" Click="AddPreset_Click" Margin="0,0,6,6"/>
                                        <Button Content="폴더 열기" Click="OpenFolder_Click" Margin="0,0,6,6"/>
                                        <Button Content="선택 삭제" Style="{StaticResource DangerButton}" Click="RemoveMod_Click" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <ListBox x:Name="ModList" ItemsSource="{Binding Mods}" SelectionMode="Extended">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ModEntry}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled}" Click="ModEnabled_Click" VerticalAlignment="Center" ToolTip="켜기/끄기"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13.5"/>
                                                    <Border Grid.Column="2" CornerRadius="9" Background="#1FFFFFFF" Padding="9,3" Margin="10,0">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#FFC857" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="설정">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="프로필 이름" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="360" HorizontalAlignment="Left"/>

                                        <TextBlock Text="마인크래프트 버전" Style="{StaticResource Muted}" Margin="0,18,0,8"/>
                                        <WrapPanel x:Name="VersionPills"/>

                                        <DockPanel Margin="0,14,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryMb, StringFormat={}{0} MB}" FontWeight="SemiBold"/>
                                            <TextBlock Text="메모리" Style="{StaticResource Muted}"/>
                                        </DockPanel>
                                        <Slider Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb}" Width="460" HorizontalAlignment="Left"/>

                                        <TextBlock Text="게임 창 크기 (0 이면 기본값)" Style="{StaticResource Muted}" Margin="0,18,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="90" Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBox Width="90" Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <TextBlock Text="추가 JVM 인수 (보통은 비워 두세요)" Style="{StaticResource Muted}" Margin="0,18,0,6"/>
                                        <TextBox Text="{Binding ExtraJvmArgs}" Width="460" HorizontalAlignment="Left"/>

                                        <CheckBox Margin="0,20,0,0" IsChecked="{Binding ApplyPerformanceOptions}"
                                                  Content="첫 설치 때 성능 옵션 적용 (렌더 거리·파티클·구름·그림자·수직동기화)"/>
                                        <Button Content="성능 옵션 지금 적용" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ApplyOptions_Click"/>

                                        <TextBlock Text="정품 (공식 런처) · 모든 프로필 공통" Style="{StaticResource Muted}" Margin="0,24,0,6"/>
                                        <CheckBox x:Name="CloseOfficialCheck" Content="게임이 켜지면 공식 런처 닫기"
                                                  Checked="CloseOfficial_Changed" Unchecked="CloseOfficial_Changed"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"
                                                   Text="정품으로 플레이하면 게임 창이 뜬 뒤 공식 런처를 닫아요. 게임은 그대로 켜져 있어요."/>

                                        <TextBlock Text="업데이트" Style="{StaticResource Muted}" Margin="0,24,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button x:Name="UpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="런처를 켤 때마다 새 버전이 있는지 확인하고, 있으면 업데이트할지 물어봐요."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="로그">
                                <TextBox x:Name="LogBox" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                                         Background="#AA0C0D11"/>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- 상태 표시줄 -->
                    <Grid Grid.Row="2" Margin="6,10,6,0">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Text="준비 완료 · 플레이를 누르면 공식 런처 없이 바로 실행돼요."/>
                        <Border x:Name="Busy" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-6" CornerRadius="2" ClipToBounds="True"
                                Background="#22FFFFFF" Visibility="Collapsed">
                            <Border x:Name="BusyBar" Width="160" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource AccentGradient}">
                                <Border.RenderTransform><TranslateTransform x:Name="BusyMove" X="-160"/></Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 알림 (오른쪽 아래) ===== -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,46" Padding="16,12"
                CornerRadius="14" Background="#F21C1E25" BorderBrush="#66E5383B" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastMove" Y="20"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#E5383B"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
                    <TextBlock Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13.5" MaxWidth="360" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
